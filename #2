<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#0b0e14">
<title>Indigo PWA</title>
<style>
  :root {
    --bg: #0b0e14;
    --panel: #141924;
    --accent: #7c6cf0;
    --text: #d8dee9;
    --dim: #5c6678;
    --user-bubble: #2a3350;
    --danger: #e05561;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg); color: var(--text);
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
    height: 100dvh; display: flex; flex-direction: column;
  }
  header {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 20px; border-bottom: 1px solid #1f2635;
  }
  #orb {
    width: 40px; height: 40px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #b3a8ff, var(--accent) 60%, #4a3fa0);
    box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 60%, transparent);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  #orb.listening { animation: pulse 1.4s ease-in-out infinite; }
  #orb.thinking  { animation: spin 1s linear infinite; border-radius: 40% 60% 55% 45%; }
  @keyframes pulse { 50% { transform: scale(1.15); } }
  @keyframes spin  { to { transform: rotate(360deg); } }

  #emotion { font-size: 13px; color: var(--dim); margin-left: auto; }
  #emotion b { color: var(--accent); }

  #camPanel {
    display: none; position: relative; max-height: 200px; overflow: hidden;
    background: #000; border-bottom: 1px solid #1f2635;
  }
  #video { width: 100%; height: 200px; object-fit: cover; }

  main {
    flex: 1; overflow-y: auto; padding: 20px; display: flex;
    flex-direction: column; gap: 10px;
  }
  .bubble {
    max-width: 80%; padding: 10px 14px; border-radius: 16px;
    line-height: 1.5; white-space: pre-wrap; word-break: break-word;
  }
  .user { align-self: flex-end; background: var(--user-bubble); border-bottom-right-radius: 4px; }
  .bot { align-self: flex-start; background: var(--panel); border-bottom-left-radius: 4px; }
  .bot.streaming::after {
    content: "▍"; color: var(--accent); animation: blink 0.8s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .sys { align-self: center; color: var(--dim); font-size: 12px; }

  footer {
    display: flex; gap: 8px; padding: 14px 20px;
    border-top: 1px solid #1f2635; align-items: center;
  }
  input[type="text"] {
    flex: 1; background: var(--panel); border: 1px solid #232c40;
    border-radius: 22px; padding: 12px 18px; color: var(--text);
    font-size: 15px; outline: none;
  }
  input[type="text"]:focus { border-color: var(--accent); }
  button {
    width: 42px; height: 42px; border-radius: 50%; border: none;
    background: var(--panel); color: white; cursor: pointer;
    font-size: 16px; transition: filter .15s, transform .1s, background .2s;
    display: flex; align-items: center; justify-content: center;
  }
  button:hover { filter: brightness(1.2); }
  button:active { transform: scale(.93); }
  button.active { background: var(--accent); }
  button.mic-on { background: var(--danger); animation: pulse 1.4s ease-in-out infinite; }
  button:disabled { opacity: .4; cursor: default; }
</style>
</head>
<body>

<header>
  <div id="orb"></div>
  <div>
    <div style="font-weight:600">indigo</div>
    <div id="status" style="font-size:12px;color:var(--dim)">connecting…</div>
  </div>
  <div id="emotion">neutral · 0.0</div>
</header>

<div id="camPanel">
  <video id="video" autoplay playsinline muted></video>
  <canvas id="snapCanvas" hidden></canvas>
</div>

<main id="log"></main>

<footer>
  <button id="camBtn" title="Toggle Camera">👁</button>
  <button id="micBtn" title="Toggle Mic">🎙</button>
  <button id="modeBtn" title="Toggle Mode">🔒</button>
  <input type="text" id="input" placeholder="Say something…" autocomplete="off">
  <button id="sendBtn" style="background:var(--accent)" title="Send">➤</button>
</footer>

<script>
// PWA Service Worker Registration
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js').catch(() => {});
  });
}

const params = new URLSearchParams(location.search);
const host = location.hostname || "localhost";
const WS_URL = `ws://${host}:8081/?key=${encodeURIComponent(params.get("key") ?? "")}`;
const SESSION = sessionStorage.getItem("indigo_sid") ?? crypto.randomUUID();
sessionStorage.setItem("indigo_sid", SESSION);

const $ = (id) => document.getElementById(id);
const logEl = $("log");
const inputEl = $("input");
const orb = $("orb");
const statusEl = $("status");
const emotionEl = $("emotion");
const video = $("video");
const snapCanvas = $("snapCanvas");

let ws = null;
let currentBot = null, fullReply = "";
let currentMode = "safe";
let camStream = null;
let listening = false, rec = null;
let pendingFrame = null;
const FRAME_W = 512;

const VISION_PATTERNS = [
  /\b(look|looking)\s+(at|here)\b/i,
  /\bwhat\s+(am\s+i\s+holding|do\s+you\s+see|is\s+(this|that))\b/i,
  /\bcan\s+you\s+see\b/i,
  /\bdescribe\s+(this|that|it)\b/i
];

function setStatus(txt) { statusEl.textContent = txt; }
function setOrb(cls) { orb.className = cls; }
function esc(str) { return String(str).replace(/[&<>"']/g, ""); }
function scrollBottom() { logEl.scrollTop = logEl.scrollHeight; }

function addBubble(type, text) {
  const div = document.createElement("div");
  div.className = `bubble ${type}`;
  div.textContent = text;
  logEl.appendChild(div);
  scrollBottom();
  return div;
}

function connect() {
  ws = new WebSocket(WS_URL);
  ws.onopen = () => setStatus("connected");
  ws.onmessage = (e) => handleEvent(JSON.parse(e.data));
  ws.onclose = () => { setStatus("reconnecting…"); setTimeout(connect, 1500); };
  ws.onerror = () => setStatus("error");
}

function grabFrame() {
  if (!camStream || !video.videoWidth) return null;
  const ctx = snapCanvas.getContext("2d");
  const h = Math.round(FRAME_W * video.videoHeight / video.videoWidth);
  snapCanvas.width = FRAME_W; 
  snapCanvas.height = h;
  ctx.drawImage(video, 0, 0, FRAME_W, h);
  return snapCanvas.toDataURL("image/jpeg", 0.7).split(",")[1];
}

function dispatchUserInput(text) {
  const isVision = camStream && VISION_PATTERNS.some(p => p.test(text));
  if (isVision || (text.startsWith("/") && camStream)) {
    const question = text.startsWith("/") ? text.slice(1).trim() : text;
    sendVision(question);
  } else {
    sendText(text);
  }
}

function sendText(text) {
  if (!ws || ws.readyState !== WebSocket.OPEN || !text.trim()) return;
  addBubble("user", text);
  inputEl.value = "";
  currentBot = addBubble("bot", "");
  currentBot.classList.add("streaming");
  fullReply = "";
  setOrb("thinking");
  ws.send(JSON.stringify({ kind: "text", sessionId: SESSION, message: text, mode: currentMode }));
}

function sendVision(question) {
  const img = pendingFrame ?? grabFrame();
  pendingFrame = null;
  if (!img) { sendText(question); return; }
  addBubble("user", `📷 ${question}`);
  inputEl.value = "";
  currentBot = addBubble("bot", "");
  currentBot.classList.add("streaming");
  fullReply = "";
  setOrb("thinking");
  ws.send(JSON.stringify({ kind: "image", sessionId: SESSION, image: img, caption: question, mode: currentMode }));
}

function handleEvent(ev) {
  switch (ev.type) {
    case "token":
      fullReply += ev.text;
      if (currentBot) currentBot.textContent = fullReply;
      scrollBottom();
      break;
    case "emotion":
      emotionEl.innerHTML = `<b>${esc(ev.state)}</b> · ${(+ev.intensity).toFixed(1)}`;
      break;
    case "turn_end":
      if (currentBot) currentBot.classList.remove("streaming");
      setOrb("");
      speak(fullReply);
      if (ev.memoriesStored) addBubble("sys", `${ev.memoriesStored} memories stored`);
      break;
    case "error":
      addBubble("sys", `⚠ ${ev.message}`);
      if (currentBot) currentBot.classList.remove("streaming");
      setOrb("");
      break;
  }
}

function speak(text) {
  if (!('speechSynthesis' in window) || !text) return;
  window.speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text);
  window.speechSynthesis.speak(utter);
}

// Camera Toggle
$("camBtn").onclick = async () => {
  if (camStream) {
    camStream.getTracks().forEach(t => t.stop());
    camStream = null;
    video.srcObject = null;
    $("camPanel").style.display = "none";
    $("camBtn").classList.remove("active");
  } else {
    try {
      camStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" } });
      video.srcObject = camStream;
      $("camPanel").style.display = "block";
      $("camBtn").classList.add("active");
    } catch (e) {
      addBubble("sys", `⚠ Camera denied: ${e.message}`);
    }
  }
};

// Mode Toggle
$("modeBtn").onclick = () => {
  currentMode = currentMode === "safe" ? "mature" : "safe";
  $("modeBtn").textContent = currentMode === "mature" ? "🔓" : "🔒";
  addBubble("sys", `System mode switched to: ${currentMode}`);
};

// Controls & Speech API
$("sendBtn").onclick = () => dispatchUserInput(inputEl.value);
inputEl.onkeydown = (e) => { if (e.key === "Enter") dispatchUserInput(inputEl.value); };

const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
if (SR) {
  rec = new SR();
  rec.continuous = true;
  rec.interimResults = true;
  rec.onresult = (e) => {
    for (let i = e.resultIndex; i < e.results.length; i++) {
      const transcript = e.results[i][0].transcript;
      if (!e.results[i].isFinal) {
        if (camStream && VISION_PATTERNS.some(p => p.test(transcript)) && !pendingFrame) {
          pendingFrame = grabFrame();
          setOrb("listening");
        }
      } else {
        dispatchUserInput(transcript);
      }
    }
  };
  rec.onend = () => {
    listening = false;
    $("micBtn").classList.remove("mic-on");
    setOrb("");
  };

  $("micBtn").onclick = () => {
    if (listening) {
      rec.stop();
    } else {
      rec.start();
      listening = true;
      $("micBtn").classList.add("mic-on");
      setOrb("listening");
    }
  };
} else {
  $("micBtn").disabled = true;
}

connect();
</script>
</body>
</html>
