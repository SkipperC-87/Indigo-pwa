<!DOCTYPE html>
<!-- ============================================================================
  indigo-client.html — EYES & EARS & INTERFACE
============================================================================ -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Indigo</title>
<style>
  :root {
    --bg: #0b0e14;
    --panel: #141924;
    --accent: #7c6cf0;
    --text: #d8dee9;
    --dim: #5c6678;
    --user-bubble: #2a3350;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg); color: var(--text);
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
    height: 100dvh; display: flex; flex-direction: column;
  }
  header {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 20px; border-bottom: 1px solid #1f2635;
  }
  #orb {
    width: 44px; height: 44px; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #b3a8ff, var(--accent) 60%, #4a3fa0);
    box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 60%, transparent);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  #orb.listening { animation: pulse 1.4s ease-in-out infinite; }
  #orb.thinking  { animation: spin 1s linear infinite; border-radius: 40% 60% 55% 45%; }
  @keyframes pulse { 50% { transform: scale(1.15); } }
  @keyframes spin  { to { transform: rotate(360deg); } }

  #emotion { font-size: 13px; color: var(--dim); margin-left: auto; }
  #emotion b { color: var(--accent); }

  main {
    flex: 1; overflow-y: auto;
    padding: 20px; display: flex; flex-direction: column; gap: 10px;
  }
  .bubble {
    max-width: 78%; padding: 10px 14px; border-radius: 16px;
    line-height: 1.5; white-space: pre-wrap; word-break: break-word;
  }
  .user { align-self: flex-end; background: var(--user-bubble); border-bottom-right-radius: 4px; }
  .bot { align-self: flex-start; background: var(--panel); border-bottom-left-radius: 4px; }
  .bot.streaming::after {
    content: "▍"; color: var(--accent); animation: blink 0.8s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .sys { align-self: center; color: var(--dim); font-size: 12px; }

  footer {
    display: flex; gap: 10px; padding: 14px 20px;
    border-top: 1px solid #1f2635; align-items: center;
  }
  input[type="text"] {
    flex: 1; background: var(--panel); border: 1px solid #232c40;
    border-radius: 22px; padding: 12px 18px; color: var(--text);
    font-size: 15px; outline: none;
  }
  input[type="text"]:focus { border-color: var(--accent); }
  button {
    width: 46px; height: 46px; border-radius: 50%; border: none;
    background: var(--accent); color: white; cursor: pointer;
    font-size: 18px; transition: filter .15s, transform .1s;
  }
  button:hover { filter: brightness(1.2); }
  button:active { transform: scale(.93); }
  button.mic-on { background: #e05561; animation: pulse 1.4s ease-in-out infinite; }
  button:disabled { opacity: .4; cursor: default; }
</style>
</head>
<body>

<header>
  <div id="orb"></div>
  <div>
    <div style="font-weight:600">indigo</div>
    <div id="status" style="font-size:12px;color:var(--dim)">disconnected</div>
  </div>
  <div id="emotion">neutral · 0.0</div>
</header>

<main id="log"></main>

<footer>
  <button id="micBtn" title="Toggle Mic">🎙</button>
  <input type="text" id="input" placeholder="Say something…" autocomplete="off">
  <button id="sendBtn" title="Send">➤</button>
</footer>

<script>
const params = new URLSearchParams(location.search);
const host = location.hostname || "localhost";
const WS_URL = `ws://${host}:8081/?key=${encodeURIComponent(params.get("key") ?? "")}`;
const SESSION = sessionStorage.getItem("indigo_sid") ?? crypto.randomUUID();
sessionStorage.setItem("indigo_sid", SESSION);
const SPEAK = true;

const $ = (id) => document.getElementById(id);
const logEl = $("log");
const inputEl = $("input");
const orb = $("orb");
const statusEl = $("status");
const emotionEl = $("emotion");

let ws = null;
let currentBot = null, fullReply = "";

function setStatus(txt) { statusEl.textContent = txt; }
function setOrb(cls) { orb.className = cls; }
function esc(str) { return String(str).replace(/[&<>"']/g, ""); }

function scrollBottom() { logEl.scrollTop = logEl.scrollHeight; }

function addBubble(type, text) {
  const div = document.createElement("div");
  div.className = `bubble ${type}`;
  div.textContent = text;
  logEl.appendChild(div);
  scrollBottom();
  return div;
}

function connect() {
  ws = new WebSocket(WS_URL);
  ws.onopen = () => setStatus("connected");
  ws.onmessage = (e) => handleEvent(JSON.parse(e.data));
  ws.onclose = () => { setStatus("reconnecting…"); setTimeout(connect, 1500); };
  ws.onerror = () => setStatus("error");
}

function sendText(text) {
  if (!ws || ws.readyState !== WebSocket.OPEN || !text.trim()) return;
  addBubble("user", text);
  inputEl.value = "";
  currentBot = addBubble("bot", "");
  currentBot.classList.add("streaming");
  fullReply = "";
  setOrb("thinking");
  ws.send(JSON.stringify({ kind: "text", sessionId: SESSION, message: text }));
}

function handleEvent(ev) {
  switch (ev.type) {
    case "token":
      fullReply += ev.text;
      if (currentBot) currentBot.textContent = fullReply;
      scrollBottom();
      break;
    case "emotion":
      emotionEl.innerHTML = `<b>${esc(ev.state)}</b> · ${(+ev.intensity).toFixed(1)}`;
      break;
    case "turn_end":
      if (currentBot) currentBot.classList.remove("streaming");
      setOrb("");
      if (SPEAK && fullReply) speak(fullReply);
      if (ev.memoriesStored) addBubble("sys", `${ev.memoriesStored} memories stored`);
      break;
    case "error":
      addBubble("sys", `⚠ ${ev.message}`);
      if (currentBot) currentBot.classList.remove("streaming");
      setOrb("");
      break;
  }
}

function speak(text) {
  if (!('speechSynthesis' in window)) return;
  window.speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text);
  window.speechSynthesis.speak(utter);
}

// Event Listeners
$("sendBtn").onclick = () => sendText(inputEl.value);
inputEl.onkeydown = (e) => { if (e.key === "Enter") sendText(inputEl.value); };

// Web Speech API
const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
let listening = false, rec = null;

if (SR) {
  rec = new SR();
  rec.continuous = false;
  rec.onresult = (e) => {
    const text = e.results[0][0].transcript;
    sendText(text);
  };
  rec.onend = () => {
    listening = false;
    $("micBtn").classList.remove("mic-on");
    setOrb("");
  };

  $("micBtn").onclick = () => {
    if (listening) {
      rec.stop();
    } else {
      rec.start();
      listening = true;
      $("micBtn").classList.add("mic-on");
      setOrb("listening");
    }
  };
} else {
  $("micBtn").disabled = true;
}

connect();
</script>
</body>
</html>


