import {
  appendTurn, buildPersonaPrompt, loadHistory,
  maybeStoreFact,
} from "./memory";

const MATURE_URL  = process.env.MATURE_MODEL_URL || "http://localhost:11434/api/chat";
const MATURE_MODEL = process.env.MATURE_MODEL || "nous-hermes2";

// ── Mature path: stream from local uncensored model ─────────────────────────

async function* streamMatureReply(sessionId: string, message: string) {
  const messages = [
    { role: "system", content: await buildPersonaPrompt(sessionId, "mature") },
    ...(await loadHistory(sessionId)).map(t => ({ role: t.role, content: t.content })),
    { role: "user", content: message },
  ];

  const res = await fetch(MATURE_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ model: MATURE_MODEL, messages, stream: true }),
  });
  if (!res.ok) throw new Error(`mature model res.status:{res.status}:res.status:{await res.text()}`);

  const reader = res.body!.getReader();
  const decoder = new TextDecoder();
  let buf = "";
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    buf += decoder.decode(value, { stream: true });
    const lines = buf.split("\n");
    buf = lines.pop() ?? "";
    for (const line of lines) {
      if (!line.trim()) continue;
      const chunk = JSON.parse(line);
      if (chunk.message?.content) yield chunk.message.content;
    }
  }
}
