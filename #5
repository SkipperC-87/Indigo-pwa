// ══════════════════════════════════════════════════════════════════════
// VISION INTENT — route spoken "look" phrases to the camera
// ══════════════════════════════════════════════════════════════════════
const VISION_PATTERNS = [
  /\b(look|looking)\s+(at|here)\b/i,
  /\bwhat\s+(am\s+i\s+holding|do\s+you\s+see|i.s\s+(this|that)|is\s+(this|that))\b/i,
  /\bcan\s+you\s+see\b/i,
  /\bdescribe\s+(this|that|it)\b/i,
  /\bshow\s+me\s+what\b/i,
];

function isVisionIntent(text) {
  return camStream && VISION_PATTERNS.some(p => p.test(text));
}
Keep this list loose — false positives just mean the model gets an extra frame, which is harmless. False negatives (missing a real "look at this") are worse.

