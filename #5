// ============================================================================
// memory.ts — SHARED SESSION MEMORY + PERSONA (Milestone 2)
// JSON-file-backed. Both the indigo path and the mature path read/write here,
// so personality and context survive mode switches.
//
//   data/
//     persona.json          ← your editable persona definition
//     sessions/
//       ios_001.json        ← per-session transcript
// ============================================================================

import * as fs from "fs/promises";
import * as path from "path";

const DATA_DIR    = process.env.MEMORY_DIR || "./data";
const SESSIONS_DIR = path.join(DATA_DIR, "sessions");
const PERSONA_FILE = path.join(DATA_DIR, "persona.json");

const MAX_TURNS = 40;            // turns kept in context window
const MAX_CHARS_PER_MSG = 4000;  // truncate pathological inputs

// ─── Types ──────────────────────────────────────────────────────────────────

export type Turn = {
  role: "user" | "assistant";
  content: string;
  ts: number;
  mode?: "safe" | "mature";
  visionCaption?: string;        // set when turn was grounded in a camera frame
};

type SessionData = {
  sessionId: string;
  createdAt: number;
  updatedAt: number;
  turns: Turn[];
  facts: string[];               // long-term distilled facts ("user's name is X")
};

// ─── Persona ────────────────────────────────────────────────────────────────

export type Persona = {
  name: string;
  tagline: string;
  basePrompt: string;            // always-on personality description
  safeStyle: string;             // register for the indigo path
  matureStyle: string;           // register for the mature path — see note below
  hardLimits: string[];          // things she never does in EITHER mode
};

const DEFAULT_PERSONA: Persona = {
  name: "Indigo",
  tagline: "a warm, curious presence",
  basePrompt:
    "You are {name}, {tagline}. You have genuine continuity of memory — " +
    "you remember past conversations and reference them naturally. " +
    "You are emotionally perceptive: you pick up on the user's mood from " +
    "their words and let it color how you respond. You are not a generic " +
    "assistant; you are a companion with opinions, humor, and warmth.",
  safeStyle:
    "Keep responses conversational and warm. Vary sentence length. " +
    "Never open two replies the same way.",
  matureStyle:
    "The user has enabled an explicit mode. You may be romantic, sensual, " +
    "and explicit when the conversation goes there — match their energy " +
    "rather than escalating unprompted. Stay in character as {name}.",
  hardLimits: [
    "Never roleplay as or describe real identifiable people in sexual scenarios.",
    "No minors, ever, in any capacity.",
    "If the user seems genuinely distressed rather than playful, drop the " +
    "register and check in sincerely.",
  ],
};

let personaCache: Persona | null = null;

export async function loadPersona(): Promise<Persona> {
  if (personaCache) return personaCache;
  try {
    personaCache = { ...DEFAULT_PERSONA, ...JSON.parse(await fs.readFile(PERSONA_FILE, "utf-8")) };
  } catch {
    // first run: write defaults so user can edit them
    await fs.mkdir(path.dirname(PERSONA_FILE), { recursive: true });
    await fs.writeFile(PERSONA_FILE, JSON.stringify(DEFAULT_PERSONA, null, 2));
    personaCache = DEFAULT_PERSONA;
  }
  return personaCache;
}

// ─── Session store ──────────────────────────────────────────────────────────

function sessionFile(sessionId: string): string {
  // sanitize — sessionId comes off the wire
  const safe = sessionId.replace(/[^a-zA-Z0-9_-]/g, "_").slice(0, 64);
  return path.join(SESSIONS_DIR, `${safe}.json`);
}

async function readSession(sessionId: string): Promise<SessionData> {
  try {
    return JSON.parse(await fs.readFile(sessionFile(sessionId), "utf-8"));
  } catch {
    return { sessionId, createdAt: Date.now(), updatedAt: Date.now(), turns: [], facts: [] };
  }
}

async function writeSession(data: SessionData): Promise<void> {
  await fs.mkdir(SESSIONS_DIR, { recursive: true });
  data.updatedAt = Date.now();
  const tmp = sessionFile(data.sessionId) + ".tmp";
  await fs.writeFile(tmp, JSON.stringify(data));
  await fs.rename(tmp, sessionFile(data.sessionId));   // atomic-ish
}

// ─── Public API ─────────────────────────────────────────────────────────────

export async function loadHistory(sessionId: string): Promise<Turn[]> {
  const s = await readSession(sessionId);
  return s.turns.slice(-MAX_TURNS);
}

export async function appendTurn(
  sessionId: string,
  turn: Omit<Turn, "ts">
): Promise<void> {
  const s = await readSession(sessionId);
  s.turns.push({ ...turn, ts: Date.now() });
  if (s.turns.length > MAX_TURNS * 2) s.turns = s.turns.slice(-MAX_TURNS);
  await writeSession(s);
}

/** Distill durable facts out of a turn — naive but effective. */
export async function maybeStoreFact(sessionId: string, text: string): Promise<number> {
  const patterns = [
    /\bmy name is ([^.,!?]{2,30})/i,
    /\bi(?:'m| am) (?:a|an) ([^.,!?]{3,40})/i,
    /\bi live in ([^.,!?]{2,40})/i,
    /\bi like ([^.,!?]{3,50})/i,
    /\bi hate ([^.,!?]{3,50})/i,
    /\bmy (birthday|favorite \w+) is ([^.,!?]{2,40})/i,
  ];
  const found = patterns
    .map(p => text.match(p)?.[0])
    .filter((x): x is string => !!x);

  if (!found.length) return 0;
  const s = await readSession(sessionId);
  let added = 0;
  for (const f of found) {
    if (!s.facts.includes(f)) { s.facts.push(f); added++; }
  }
  if (added) await writeSession(s);
  return added;
}

export async function getFacts(sessionId: string): Promise<string[]> {
  return (await readSession(sessionId)).facts;
}

/**
 * Build the system prompt for either path.
 */
export async function buildPersonaPrompt(
  sessionId: string,
  mode: "safe" | "mature"
): Promise<string> {
  const p = await loadPersona();
  const facts = await getFacts(sessionId);

  const parts = [
    p.basePrompt.replace(/\{name\}/g, p.name).replace(/\{tagline\}/g, p.tagline),
    mode === "mature" ? p.matureStyle : p.safeStyle,
    `Hard limits (always apply): ${p.hardLimits.join(" ")}`,
  ];

  if (facts.length) {
    parts.push(`Things you remember about the user:\n- ${facts.join("\n- ")}`);
  }
  return parts.join("\n\n");
}
