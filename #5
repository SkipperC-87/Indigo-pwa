const MATURE_MODEL_URL = process.env.MATURE_MODEL_URL || "http://localhost:11434/api/chat";
const MATURE_MODEL     = process.env.MATURE_MODEL || "nous-hermes2";

async function* streamMatureReply(sessionId: string, message: string) {
  const res = await fetch(MATURE_MODEL_URL, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      model: MATURE_MODEL,
      messages: [
        { role: "system", content: await buildPersonaPrompt(sessionId) },
        ...await loadHistory(sessionId),      // same session memory as indigo
        { role: "user", content: message },
      ],
      stream: true,
    }),
  });

  // Ollama NDJSON streaming
  const reader = res.body!.getReader();
  let reply = "";
  const decoder = new TextDecoder();
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    for (const line of decoder.decode(value).split("\n")) {
      if (!line.trim()) continue;
      const chunk = JSON.parse(line);
      if (chunk.message?.content) {
        reply += chunk.message.content;
        yield chunk.message.content;
      }
    }
  }
  await storeHistory(sessionId, message, reply);
}
